# ==============================================================================
# EVENTORA ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Supabase Credentials (Required for Live Supabase Integration)
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Real Outbound Email Delivery (Optional: Gmail SMTP or standard provider)
# Used for real-time registration confirmation and pass dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=your-email@gmail.com
